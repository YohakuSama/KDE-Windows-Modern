+// Windows Modern publishes a receipt only after the renderer transaction.
+// Keep other themes and widget-local styles outside this reload path.
+static QByteArray wmFileDigest(const QString &path)
+{
+  const QFileInfo info(path);
+  if (!info.isFile() || info.isSymLink())
+    return {};
+  QFile file(path);
+  constexpr qint64 limit = 8 * 1024 * 1024;
+  if (!file.open(QIODevice::ReadOnly) || file.size() <= 0 || file.size() > limit)
+    return {};
+  const QByteArray bytes = file.read(limit + 1);
+  if (bytes.isEmpty() || bytes.size() > limit || !file.atEnd() || file.error() != QFileDevice::NoError)
+    return {};
+  return QCryptographicHash::hash(bytes, QCryptographicHash::Sha256).toHex();
+}
+
+static QByteArray wmPairDigest(const QString &config, const QString &svg)
+{
+  const auto a = wmFileDigest(config);
+  const auto b = wmFileDigest(svg);
+  return a.size() == 64 && b.size() == 64 ? a + b : QByteArray();
+}
+
+static QByteArray wmReceipt(const QString &path, const QString &config, const QString &svg)
+{
+  QFile file(path);
+  const QFileInfo info(path);
+  if (!info.isFile() || info.isSymLink() || !file.open(QIODevice::ReadOnly))
+    return {};
+  const auto bytes = file.read(4097);
+  if (bytes.size() > 4096 || !file.atEnd() || file.error() != QFileDevice::NoError)
+    return {};
+  const auto root = QJsonDocument::fromJson(bytes).object();
+  if (root.value(QStringLiteral("schema_version")).toInt() != 1)
+    return {};
+  const auto files = root.value(QStringLiteral("files")).toObject();
+  const auto a = files.value(QFileInfo(config).fileName()).toString().toLatin1();
+  const auto b = files.value(QFileInfo(svg).fileName()).toString().toLatin1();
+  return a.size() == 64 && b.size() == 64 ? a + b : QByteArray();
+}
