+
+void Style::watchWindowsModernTheme(bool useDark)
+{
+  if (wmConfigPath_.isEmpty() || wmSvgPath_.isEmpty() || !themeRndr_ || !themeRndr_->isValid())
+    return;
+  const QString dir = QFileInfo(wmConfigPath_).absolutePath();
+  const QString parentDir = QFileInfo(dir).absolutePath();
+  const QString receipt = dir + QStringLiteral("/live-reload.json");
+  const QString runtime = qEnvironmentVariable("XDG_RUNTIME_DIR");
+  if (runtime.isEmpty())
+    return;
+  const QString lockPath = runtime + QStringLiteral("/windows-modern-appearance.lock");
+  auto *watcher = new QFileSystemWatcher(this);
+  auto *timer = new QTimer(this);
+  timer->setSingleShot(true);
+  timer->setInterval(250);
+  const auto retries = std::make_shared<int>(0);
+  const auto arm = [watcher, parentDir, dir, receipt]() {
+    for (const auto &path : {parentDir, dir}) {
+      if (QFileInfo(path).isDir() && !watcher->directories().contains(path))
+        watcher->addPath(path);
+    }
+    if (QFileInfo(receipt).isFile() && !watcher->files().contains(receipt))
+      watcher->addPath(receipt);
+  };
+  const auto schedule = [timer, retries](const QString &) {
+    *retries = 0;
+    timer->start();
+  };
+  connect(watcher, &QFileSystemWatcher::directoryChanged, this, schedule);
+  connect(watcher, &QFileSystemWatcher::fileChanged, this, schedule);
+  arm();
+
+  // Deliver on the application object, not a timer owned by the old
+  // style: QApplication::setStyle can delete that style synchronously.
+  const QPointer<Style> guard(this);
+  connect(timer, &QTimer::timeout, qApp, [guard, timer, retries, arm, receipt, lockPath, useDark]() {
+    if (!guard || QCoreApplication::closingDown() || QApplication::style() != guard.data())
+      return;
+    arm();
+    const auto wanted = wmReceipt(receipt, guard->wmConfigPath_, guard->wmSvgPath_);
+    if (wanted.isEmpty() || wanted == guard->wmLoadedDigest_)
+      return;
+    const QString key = useDark ? QStringLiteral("kvantum-dark") : QStringLiteral("kvantum");
+    if (guard->name().compare(key, Qt::CaseInsensitive) != 0)
+      return;
+
+    QFile lock(lockPath);
+    if (QFileInfo(lockPath).isSymLink() || !lock.open(QIODevice::ReadOnly)
+        || flock(lock.handle(), LOCK_SH | LOCK_NB) != 0) {
+      if (++*retries <= 40)
+        timer->start();
+      return;
+    }
+    if (wmReceipt(receipt, guard->wmConfigPath_, guard->wmSvgPath_) != wanted
+        || wmPairDigest(guard->wmConfigPath_, guard->wmSvgPath_) != wanted)
+      return;
+
+    // QSettings shares a process-local file cache. Refresh it before
+    // constructing a new style from the atomically replaced configuration.
+    QSettings fresh(guard->wmConfigPath_, QSettings::NativeFormat);
+    fresh.sync();
+    if (fresh.status() != QSettings::NoError)
+      return;
+    // Qt 6 sets QStyle::name() privately in QStyleFactory::create().
+    // Construct through that factory and reject a different plugin.
+    std::unique_ptr<QStyle> next(QStyleFactory::create(key));
+    if (!next || next->metaObject() != &Style::staticMetaObject || !guard)
+      return;
+    auto *candidate = static_cast<Style *>(next.get());
+    if (candidate->wmConfigPath_ != guard->wmConfigPath_ || candidate->wmSvgPath_ != guard->wmSvgPath_
+        || candidate->wmLoadedDigest_ != wanted || !candidate->themeRndr_ || !candidate->themeRndr_->isValid()
+        || wmPairDigest(guard->wmConfigPath_, guard->wmSvgPath_) != wanted)
+      return;
+    // Do not hold the appearance lock while Qt notifies application widgets.
+    lock.close();
+    if (!guard || QApplication::style() != guard.data())
+      return;
+    QPixmapCache::clear();
+    QApplication::setStyle(next.release());
+  }, Qt::QueuedConnection);
+  // Reconcile a receipt published while the original style was loading.
+  timer->start();
+}
