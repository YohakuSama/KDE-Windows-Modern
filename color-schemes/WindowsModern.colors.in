[ColorEffects:Disabled]
Color=${disabled_text}
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=112,111,110
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

[Colors:Button]
BackgroundAlternate=${button_alternate}
BackgroundNormal=${button}
DecorationFocus=${accent}
DecorationHover=${light_surface}
ForegroundActive=${button_active_text}
ForegroundInactive=${inactive_text}
ForegroundLink=${accent}
ForegroundNegative=232,17,35
ForegroundNeutral=255,140,0
ForegroundNormal=${text}
ForegroundPositive=16,137,62
ForegroundVisited=${visited_text}

[Colors:Complementary]
BackgroundAlternate=${window_alternate}
BackgroundNormal=${window}
DecorationFocus=${accent}
DecorationHover=${light_surface}
ForegroundActive=${accent}
ForegroundInactive=${inactive_text}
ForegroundLink=${accent}
ForegroundNegative=${negative}
ForegroundNeutral=${neutral}
ForegroundNormal=${text}
ForegroundPositive=${positive}
ForegroundVisited=${visited_text}

[Colors:Selection]
BackgroundAlternate=${accent}
BackgroundNormal=${accent}
DecorationFocus=${accent}
DecorationHover=${light_surface}
ForegroundActive=${highlight_text}
ForegroundInactive=${selection_inactive}
ForegroundLink=${selection_link}
ForegroundNegative=${selection_negative}
ForegroundNeutral=${selection_neutral}
ForegroundNormal=${highlight_text}
ForegroundPositive=${selection_positive}
ForegroundVisited=${selection_visited}

[Colors:Tooltip]
BackgroundAlternate=${tooltip_surface}
BackgroundNormal=${tooltip_surface}
DecorationFocus=${accent}
DecorationHover=${light_surface}
ForegroundActive=${accent}
ForegroundInactive=${inactive_text}
ForegroundLink=${accent}
ForegroundNegative=${negative}
ForegroundNeutral=${neutral}
ForegroundNormal=${text}
ForegroundPositive=${positive}
ForegroundVisited=${visited_text}

[Colors:View]
BackgroundAlternate=${view_alternate}
BackgroundNormal=${base}
DecorationFocus=${accent}
DecorationHover=${light_surface}
ForegroundActive=${accent}
ForegroundInactive=${inactive_text}
ForegroundLink=${accent}
ForegroundNegative=${negative}
ForegroundNeutral=${neutral}
ForegroundNormal=${text}
ForegroundPositive=${positive}
ForegroundVisited=${visited_text}

[Colors:Window]
BackgroundAlternate=${window_alternate}
BackgroundNormal=${window}
DecorationFocus=${accent}
DecorationHover=${light_surface}
ForegroundActive=${accent}
ForegroundInactive=${inactive_text}
ForegroundLink=${accent}
ForegroundNegative=${negative}
ForegroundNeutral=${neutral}
ForegroundNormal=${text}
ForegroundPositive=${positive}
ForegroundVisited=${visited_text}

[General]
ColorScheme=${scheme_id}
Name=${scheme_name}
shadeSortColumn=true

[KDE]
contrast=4

[WM]
activeBackground=${window}
activeBlend=${wm_blend}
activeForeground=${text}
inactiveBackground=${wm_inactive_background}
inactiveBlend=${wm_blend}
inactiveForeground=${inactive_text}
