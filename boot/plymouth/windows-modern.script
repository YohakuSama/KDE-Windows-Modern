# Optional early-boot theme. Real boot progress and password prompts are
# owned by Plymouth. No timers block the boot process and no input is logged.
Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();
center_x = Window.GetX() + screen_width / 2;
center_y = Window.GetY() + screen_height / 2;
scale = screen_height / 1080.0;
if (scale < 0.65) scale = 0.65;
if (scale > 2.0) scale = 2.0;

logo_image = Image("logo.png");
logo_image = logo_image.Scale(Math.Int(logo_image.GetWidth() * scale), Math.Int(logo_image.GetHeight() * scale));
logo = Sprite(logo_image);
logo.SetPosition(center_x - logo_image.GetWidth() / 2, center_y - logo_image.GetHeight() / 2, 1);

for (i = 0; i < 80; i++) {
    image = Image("ring-" + i + ".png");
    frames[i] = image.Scale(Math.Int(image.GetWidth() * scale), Math.Int(image.GetHeight() * scale));
}
ring = Sprite(frames[0]);
ring.SetPosition(center_x - frames[0].GetWidth() / 2,
    Window.GetY() + screen_height * 0.68 - frames[0].GetHeight() / 2, 2);

phase = 0;
mode = "normal";
prompt_sprite = Sprite();
response_sprite = Sprite();
message_sprite = Sprite();

fun refresh_callback() {
    if (global.mode == "normal") {
        global.phase = (global.phase + 1) % 80;
        global.ring.SetImage(global.frames[global.phase]);
    }
}
Plymouth.SetRefreshFunction(refresh_callback);

# Display actual Plymouth prompts (including LUKS), never a fake login.
# Only the bullet count is supplied for passwords; no password text is read.
fun display_prompt(prompt, response) {
    global.logo.SetOpacity(0);
    global.ring.SetOpacity(0);
    prompt_image = Image.Text(prompt, 1, 1, 1);
    response_image = Image.Text(response, 1, 1, 1);
    global.prompt_sprite.SetImage(prompt_image);
    global.prompt_sprite.SetPosition(global.center_x - prompt_image.GetWidth() / 2,
        global.center_y - prompt_image.GetHeight() - 18, 10);
    global.prompt_sprite.SetOpacity(1);
    global.response_sprite.SetImage(response_image);
    global.response_sprite.SetPosition(global.center_x - response_image.GetWidth() / 2,
        global.center_y + 6, 10);
    global.response_sprite.SetOpacity(1);
}
fun password_callback(prompt, bullet_count) {
    global.mode = "password";
    response = " ";
    for (i = 0; i < bullet_count; i++) {
        if (i < 64) response = response + "*";
    }
    display_prompt(prompt, response);
}
Plymouth.SetDisplayPasswordFunction(password_callback);

fun question_callback(prompt, entry) {
    global.mode = "question";
    if (entry == "") entry = " ";
    display_prompt(prompt, entry);
}
Plymouth.SetDisplayQuestionFunction(question_callback);

fun normal_callback() {
    global.mode = "normal";
    global.prompt_sprite.SetOpacity(0);
    global.response_sprite.SetOpacity(0);
    global.logo.SetOpacity(1);
    global.ring.SetOpacity(1);
}
Plymouth.SetDisplayNormalFunction(normal_callback);

fun message_callback(message) {
    if (message == "") {
        global.message_sprite.SetOpacity(0);
    } else {
        message_image = Image.Text(message, 1, 1, 1);
        global.message_sprite.SetImage(message_image);
        global.message_sprite.SetPosition(global.center_x - message_image.GetWidth() / 2,
            Window.GetY() + global.screen_height * 0.87, 20);
        global.message_sprite.SetOpacity(1);
    }
}
Plymouth.SetMessageFunction(message_callback);
