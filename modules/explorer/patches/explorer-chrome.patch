+void DolphinTabWidget::bindExternalTabBar(DolphinTabBar *externalTabBar)
+{
+    if (m_externalTabBar == externalTabBar) {
+        syncExternalTabBar();
+        return;
+    }
+    if (m_externalTabBar) {
+        m_externalTabBar->disconnect(this);
+    }
+    m_externalTabBar = externalTabBar;
+    if (!m_externalTabBar) {
+        return;
+    }
+    connect(m_externalTabBar, &QTabBar::currentChanged, this, [this](int index) {
+        if (index >= 0 && index < count() && index != currentIndex()) {
+            setCurrentIndex(index);
+        }
+    });
+    connect(m_externalTabBar, &QTabBar::tabCloseRequested, this, QOverload<int>::of(&DolphinTabWidget::closeTab));
+    connect(m_externalTabBar, &QTabBar::tabMoved, this, [this](int from, int to) {
+        if (from >= 0 && to >= 0 && from < count() && to < count() && from != to) {
+            tabBar()->moveTab(from, to);
+        }
+    });
+    connect(m_externalTabBar, &DolphinTabBar::openNewActivatedTab, this, QOverload<int>::of(&DolphinTabWidget::openNewActivatedTab));
+    connect(m_externalTabBar, &DolphinTabBar::tabDragMoveEvent, this, &DolphinTabWidget::tabDragMoveEvent);
+    connect(m_externalTabBar, &DolphinTabBar::tabDropEvent, this, &DolphinTabWidget::tabDropEvent);
+    connect(m_externalTabBar, &DolphinTabBar::tabDetachRequested, this, &DolphinTabWidget::detachTab);
+    connect(m_externalTabBar, &DolphinTabBar::tabRenamed, this, &DolphinTabWidget::renameTab);
+    syncExternalTabBar();
+}
+
+void DolphinTabWidget::syncExternalTabBar()
+{
+    if (!m_externalTabBar) {
+        return;
+    }
+    const QSignalBlocker blocker(m_externalTabBar);
+    m_externalTabBar->setTabsClosable(GeneralSettings::showCloseButtonOnTabs());
+    const int tabCount = count();
+    while (m_externalTabBar->count() < tabCount) {
+        m_externalTabBar->addTab(QString());
+    }
+    while (m_externalTabBar->count() > tabCount) {
+        m_externalTabBar->removeTab(m_externalTabBar->count() - 1);
+    }
+    for (int i = 0; i < tabCount; ++i) {
+        DolphinTabPage *page = tabPageAt(i);
+        const QString label = !page->customLabel().isEmpty() ? page->customLabel() : tabName(page);
+        m_externalTabBar->setTabText(i, label);
+        const QUrl url = page->activeViewContainer()->url();
+        m_externalTabBar->setTabToolTip(i, url.toDisplayString(QUrl::PreferLocalFile));
+        const QUrl pathUrl = QUrl(url.adjusted(QUrl::StripTrailingSlash).toString(QUrl::FullyEncoded).append(QLatin1Char('/')));
+        m_externalTabBar->setTabIcon(i, QIcon::fromTheme(KIO::iconNameForUrl(pathUrl)));
+    }
+    if (currentIndex() >= 0 && currentIndex() < m_externalTabBar->count()) {
+        m_externalTabBar->setCurrentIndex(currentIndex());
+    }
+}
