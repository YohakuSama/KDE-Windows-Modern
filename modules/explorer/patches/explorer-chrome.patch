+class ExplorerSearchEscapeFilter : public QObject
+{
+public:
+    ExplorerSearchEscapeFilter(QLineEdit *edit, std::function<void()> onResetOrDefocus)
+        : QObject(edit)
+        , m_edit(edit)
+        , m_onResetOrDefocus(std::move(onResetOrDefocus))
+    {
+    }
+
+protected:
+    bool eventFilter(QObject *watched, QEvent *event) override
+    {
+        if (watched == m_edit && event->type() == QEvent::KeyPress) {
+            auto *keyEvent = static_cast<QKeyEvent *>(event);
+            if (keyEvent->key() == Qt::Key_Escape) {
+                m_onResetOrDefocus();
+                return true;
+            }
+        }
+        return QObject::eventFilter(watched, event);
+    }
+
+private:
+    QLineEdit *m_edit;
+    std::function<void()> m_onResetOrDefocus;
+};
+
+QUrl resolveExplorerSearchBaseUrl(DolphinViewContainer *container)
+{
+    if (!container) {
+        return QUrl::fromLocalFile(QDir::homePath());
+    }
+    const DolphinUrlNavigator *nav = container->urlNavigatorInternalWithHistory();
+    for (int i = nav->historyIndex(); i < nav->historySize(); ++i) {
+        const QUrl candidate = nav->locationUrl(i);
+        if (isSearchUrl(candidate)) {
+            const QUrl searchPath = Search::DolphinQuery(candidate, QUrl{}).searchPath();
+            if (searchPath.isValid()) {
+                return searchPath;
+            }
+        } else if (candidate.scheme() != QLatin1String("tags") && candidate.isValid()) {
+            return candidate;
+        }
+    }
+    return QUrl::fromLocalFile(QDir::homePath());
+}
