+void DolphinMainWindow::syncExplorerChromeLayout()
+{
+    const bool usePhoneUi{KRuntimePlatform::runtimePlatform().contains(QLatin1String("phone"))};
+    auto *commandBar = usePhoneUi ? nullptr : findChild<KToolBar *>(QStringLiteral("wmCommandToolBar"), Qt::FindDirectChildrenOnly);
+    if (!commandBar) {
+        if (m_wmTabStripToolBar) {
+            m_tabWidget->bindExternalTabBar(nullptr);
+            m_wmTabStripToolBar->hide();
+        }
+        if (m_wmSearchWidgetAction) {
+            m_wmSearchWidgetAction->setVisible(false);
+        }
+        if (QAction *toggleSearch = actionCollection()->action(QStringLiteral("toggle_search"))) {
+            if (QWidget *btn = toolBar()->widgetForAction(toggleSearch)) {
+                btn->setVisible(true);
+            }
+        }
+        m_tabWidget->setTabBarAutoHide(!GeneralSettings::alwaysShowTabBar());
+        m_tabWidget->tabBar()->setVisible(GeneralSettings::alwaysShowTabBar() || m_tabWidget->count() > 1);
+        return;
+    }
+
+    if (!m_wmTabStripToolBar) {
+        m_wmTabStripToolBar = new QToolBar(this);
+        m_wmTabStripToolBar->setObjectName(QStringLiteral("wmTabStripToolBar"));
+        m_wmTabStripToolBar->setWindowTitle(i18nc("@title:menu", "Tabs"));
+        m_wmTabStripToolBar->setMovable(false);
+        m_wmTabStripToolBar->setFloatable(false);
+        m_wmTabStripToolBar->setContextMenuPolicy(Qt::PreventContextMenu);
+        m_wmTabStripToolBar->layout()->setContentsMargins(6, 2, 6, 0);
+        m_wmTabStripToolBar->layout()->setSpacing(0);
+        if (QAction *toggleAction = m_wmTabStripToolBar->toggleViewAction()) {
+            toggleAction->setVisible(false);
+        }
+
+        auto *stripContainer = new QWidget(m_wmTabStripToolBar);
+        stripContainer->setSizePolicy(QSizePolicy::Expanding, QSizePolicy::Preferred);
+        auto *stripLayout = new QHBoxLayout(stripContainer);
+        stripLayout->setContentsMargins(0, 0, 0, 0);
+        stripLayout->setSpacing(2);
+
+        m_wmTopTabBar = new DolphinTabBar(stripContainer);
+        m_wmTopTabBar->setObjectName(QStringLiteral("wmExplorerTabBar"));
+        m_wmTopTabBar->setDocumentMode(true);
+        m_wmTopTabBar->setExpanding(false);
+        m_wmTopTabBar->setUsesScrollButtons(true);
+        m_wmTopTabBar->setElideMode(GeneralSettings::showFullPathInTitlebar() ? Qt::ElideLeft : Qt::ElideRight);
+        m_wmTopTabBar->setSizePolicy(QSizePolicy::Maximum, QSizePolicy::Preferred);
+
+        m_wmTopNewTabButton = new QToolButton(stripContainer);
+        m_wmTopNewTabButton->setObjectName(QStringLiteral("wmExplorerNewTabButton"));
+        m_wmTopNewTabButton->setDefaultAction(actionCollection()->action(QStringLiteral("new_tab")));
+        m_wmTopNewTabButton->setToolButtonStyle(Qt::ToolButtonIconOnly);
+        m_wmTopNewTabButton->setAutoRaise(true);
+        m_wmTopNewTabButton->setFixedSize(28, 28);
+
+        stripLayout->addWidget(m_wmTopTabBar, 0, Qt::AlignBottom);
+        stripLayout->addWidget(m_wmTopNewTabButton, 0, Qt::AlignVCenter);
+        stripLayout->addStretch(1);
+        m_wmTabStripToolBar->addWidget(stripContainer);
+
+        connect(m_tabWidget, &DolphinTabWidget::tabCountChanged, this, [this](int) {
+            if (m_wmTabStripToolBar && findChild<KToolBar *>(QStringLiteral("wmCommandToolBar"), Qt::FindDirectChildrenOnly)) {
+                const bool showStrip = GeneralSettings::alwaysShowTabBar() || m_tabWidget->count() > 1;
+                m_wmTabStripToolBar->setVisible(showStrip);
+            }
+        });
+    }
+
+    // Ensure top-to-bottom order: [wmTabStripToolBar] -> [mainToolBar] -> [wmCommandToolBar]
+    insertToolBar(toolBar(), m_wmTabStripToolBar);
+    insertToolBarBreak(toolBar());
+    insertToolBarBreak(commandBar);
+
+    m_tabWidget->bindExternalTabBar(m_wmTopTabBar);
+    if (QWidget *corner = m_tabWidget->cornerWidget(Qt::TopRightCorner)) {
+        corner->hide();
+    }
+    m_tabWidget->setTabBarAutoHide(false);
+    m_tabWidget->tabBar()->hide();
+
+    const bool showStrip = GeneralSettings::alwaysShowTabBar() || m_tabWidget->count() > 1;
+    m_wmTabStripToolBar->setVisible(showStrip);
+
+    // Persistent Explorer-style search box at the trailing end of mainToolBar
+    if (!m_wmSearchContainer) {
+        m_wmSearchContainer = new QWidget(toolBar());
+        auto *searchLayout = new QHBoxLayout(m_wmSearchContainer);
+        searchLayout->setContentsMargins(6, 0, 2, 0);
+        searchLayout->setSpacing(0);
+
+        m_wmSearchEdit = new QLineEdit(m_wmSearchContainer);
+        m_wmSearchEdit->setObjectName(QStringLiteral("wmExplorerSearchField"));
+        m_wmSearchEdit->setClearButtonEnabled(true);
+        m_wmSearchEdit->setMinimumWidth(140);
+        m_wmSearchEdit->setMaximumWidth(240);
+        m_wmSearchEdit->setSizePolicy(QSizePolicy::Preferred, QSizePolicy::Fixed);
+
+        QAction *searchOptionsAction = m_wmSearchEdit->addAction(
+            QIcon::fromTheme(QStringLiteral("edit-find")), QLineEdit::LeadingPosition);
+        searchOptionsAction->setToolTip(i18nc("@info:tooltip", "Search options (Ctrl+F)"));
+        connect(searchOptionsAction, &QAction::triggered, this, [this]() {
+            if (!m_activeViewContainer) {
+                return;
+            }
+            const bool nextVisible = !m_activeViewContainer->isSearchBarVisible();
+            m_activeViewContainer->setSearchBarVisible(nextVisible);
+            if (nextVisible) {
+                m_activeViewContainer->setFocusToSearchBar();
+            }
+        });
+
+        m_wmSearchTimer = new QTimer(this);
+        m_wmSearchTimer->setSingleShot(true);
+        m_wmSearchTimer->setInterval(400);
+
+        const auto commitExplorerSearch = [this](bool moveFocusToView) {
+            if (!m_activeViewContainer || !m_wmSearchEdit) {
+                return;
+            }
+            m_wmSearchTimer->stop();
+            const QString term = m_wmSearchEdit->text().trimmed();
+            const QUrl baseUrl = resolveExplorerSearchBaseUrl(m_activeViewContainer);
+            if (term.isEmpty()) {
+                if (isSearchUrl(m_activeViewContainer->url()) && baseUrl.isValid()) {
+                    m_activeViewContainer->setGrabFocusOnUrlChange(false);
+                    changeUrl(baseUrl);
+                    m_activeViewContainer->setGrabFocusOnUrlChange(true);
+                }
+            } else {
+                Search::DolphinQuery query(m_activeViewContainer->url(), baseUrl);
+                query.setSearchPath(baseUrl);
+                query.setSearchLocations(Search::SearchLocations::FromHere);
+                query.setSearchTerm(term);
+                const QUrl targetUrl = query.toUrl();
+                if (targetUrl.isValid() && targetUrl != m_activeViewContainer->url()) {
+                    m_activeViewContainer->setGrabFocusOnUrlChange(false);
+                    changeUrl(targetUrl);
+                    m_activeViewContainer->setGrabFocusOnUrlChange(true);
+                }
+            }
+            if (moveFocusToView && m_activeViewContainer) {
+                m_activeViewContainer->view()->setFocus();
+            }
+        };
+
+        connect(m_wmSearchTimer, &QTimer::timeout, this, [commitExplorerSearch]() {
+            commitExplorerSearch(false);
+        });
+        connect(m_wmSearchEdit, &QLineEdit::textEdited, this, [this](const QString &text) {
+            if (text.isEmpty()) {
+                m_wmSearchTimer->start(0);
+            } else {
+                m_wmSearchTimer->start();
+            }
+        });
+        connect(m_wmSearchEdit, &QLineEdit::returnPressed, this, [commitExplorerSearch]() {
+            commitExplorerSearch(true);
+        });
+        m_wmSearchEdit->installEventFilter(new ExplorerSearchEscapeFilter(m_wmSearchEdit, [this, commitExplorerSearch]() {
+            if (!m_wmSearchEdit->text().isEmpty()) {
+                m_wmSearchEdit->clear();
+                commitExplorerSearch(false);
+            } else if (m_activeViewContainer) {
+                m_activeViewContainer->view()->setFocus();
+            }
+        }));
+
+        searchLayout->addWidget(m_wmSearchEdit);
+        m_wmSearchWidgetAction = toolBar()->addWidget(m_wmSearchContainer);
+    } else if (m_wmSearchWidgetAction && !toolBar()->actions().contains(m_wmSearchWidgetAction)) {
+        m_wmSearchWidgetAction = toolBar()->addWidget(m_wmSearchContainer);
+    }
+
+    if (m_wmSearchWidgetAction) {
+        m_wmSearchWidgetAction->setVisible(true);
+    }
+    if (QAction *toggleSearch = actionCollection()->action(QStringLiteral("toggle_search"))) {
+        if (QWidget *btn = toolBar()->widgetForAction(toggleSearch)) {
+            btn->setVisible(false);
+        }
+    }
+}
+
+void DolphinMainWindow::syncExplorerSearchField()
+{
+    if (!m_wmSearchEdit || !m_activeViewContainer) {
+        return;
+    }
+    const QUrl currentUrl = m_activeViewContainer->url();
+    QString folderLabel;
+    if (!isSearchUrl(currentUrl)) {
+        folderLabel = m_activeViewContainer->caption();
+    } else {
+        const QUrl baseUrl = resolveExplorerSearchBaseUrl(m_activeViewContainer);
+        folderLabel = baseUrl.adjusted(QUrl::StripTrailingSlash).fileName();
+        if (folderLabel.isEmpty()) {
+            folderLabel = baseUrl.isLocalFile() ? QStringLiteral("/") : baseUrl.toDisplayString(QUrl::PreferLocalFile);
+        }
+    }
+    m_wmSearchEdit->setPlaceholderText(i18nc("@info:placeholder", "Search %1", folderLabel));
+
+    if (!m_wmSearchEdit->hasFocus()) {
+        const QSignalBlocker blocker(m_wmSearchEdit);
+        if (isSearchUrl(currentUrl)) {
+            m_wmSearchEdit->setText(Search::DolphinQuery(currentUrl, QUrl{}).searchTerm());
+        } else {
+            m_wmSearchEdit->clear();
+        }
+    }
+}
