+void appendDeduplicatedActions(QMenu *menu, const QList<QAction *> &items)
+{
+    bool lastWasSeparator = true;
+    for (QAction *act : items) {
+        if (!act) {
+            continue;
+        }
+        if (act->isSeparator()) {
+            if (!lastWasSeparator) {
+                menu->addSeparator();
+                lastWasSeparator = true;
+            }
+            continue;
+        }
+        if (!act->isVisible()) {
+            menu->addAction(act);
+            continue;
+        }
+        menu->addAction(act);
+        lastWasSeparator = false;
+    }
+    const QList<QAction *> finalActions = menu->actions();
+    for (int i = finalActions.size() - 1; i >= 0; --i) {
+        if (!finalActions[i]->isVisible()) {
+            continue;
+        }
+        if (finalActions[i]->isSeparator()) {
+            menu->removeAction(finalActions[i]);
+        }
+        break;
+    }
+}
